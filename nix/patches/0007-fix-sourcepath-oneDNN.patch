--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -150,7 +150,46 @@ message(STATUS "  XPUMEM_ALLOCATOR_ENABLED     = ${XPUMEM_ALLOCATOR_ENABLED}")
 message(STATUS "  VLLM_PAGED_DECODE_CONFIG     = ${VLLM_PAGED_DECODE_CONFIG}")
 message(STATUS "  VLLM_CHUNK_PREFILL_CONFIG    = ${VLLM_CHUNK_PREFILL_CONFIG}")
 message(STATUS "")
+message(STATUS "CMAKE_SOURCE_DIR: ${CMAKE_SOURCE_DIR}")
+message(STATUS "CMAKE_CURRENT_SOURCE_DIR: ${CMAKE_CURRENT_SOURCE_DIR}")
+message(STATUS "CMAKE_BINARY_DIR: ${CMAKE_BINARY_DIR}")
+message(STATUS "")
+message(STATUS "tree path:")
+
+set(ROOT "csrc")
+
+# Recursive function
+function(print_tree DIR PREFIX)
+    # List directories and files
+    file(GLOB CHILDREN LIST_DIRECTORIES true "${DIR}/*")
+
+    list(LENGTH CHILDREN COUNT)
+    math(EXPR LAST_INDEX "${COUNT} - 1")
+
+    foreach(INDEX RANGE ${LAST_INDEX})
+        list(GET CHILDREN ${INDEX} CHILD)
 
+        get_filename_component(NAME "${CHILD}" NAME)
+
+        if(${INDEX} EQUAL ${LAST_INDEX})
+            set(BRANCH "|-- ")
+            set(NEXT_PREFIX "${PREFIX}    ")
+        else()
+            set(BRANCH "|-- ")
+            set(NEXT_PREFIX "${PREFIX}|   ")
+        endif()
+
+        message("${PREFIX}${BRANCH}${NAME}")
+
+        if(IS_DIRECTORY ${CHILD})
+            print_tree("${CHILD}" "${NEXT_PREFIX}")
+        endif()
+    endforeach()
+endfunction()
+
+message("${ROOT}")
+print_tree("${ROOT}" "")
+message(STATUS "")
